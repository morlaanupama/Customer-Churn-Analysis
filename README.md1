import pandas as pd

# Load dataset
df = pd.read_csv("customer_data.csv")

print("Customer Churn Dataset")
print(df)

# Basic Statistics
total_customers = len(df)
churned_customers = len(df[df["Churn"] == "Yes"])
churn_rate = (churned_customers / total_customers) * 100

print("\n----- Churn Analysis Report -----")
print(f"Total Customers: {total_customers}")
print(f"Churned Customers: {churned_customers}")
print(f"Churn Rate: {churn_rate:.2f}%")

# Analyze churn patterns
avg_login_churn = df[df["Churn"] == "Yes"]["LoginFrequency"].mean()
avg_login_retained = df[df["Churn"] == "No"]["LoginFrequency"].mean()

avg_tickets_churn = df[df["Churn"] == "Yes"]["SupportTickets"].mean()
avg_tickets_retained = df[df["Churn"] == "No"]["SupportTickets"].mean()

report = pd.DataFrame({
    "Metric": [
        "Average Login Frequency (Churned)",
        "Average Login Frequency (Retained)",
        "Average Support Tickets (Churned)",
        "Average Support Tickets (Retained)"
    ],
    "Value": [
        avg_login_churn,
        avg_login_retained,
        avg_tickets_churn,
        avg_tickets_retained
    ]
})

print("\nKey Findings")
print(report)

# Save report
report.to_csv("churn_report.csv", index=False)

print("\nReport saved as churn_report.csv")

# Retention Suggestions
print("\nRetention Recommendations:")
print("- Improve customer engagement through personalized offers.")
print("- Monitor users with low login frequency.")
print("- Resolve support issues faster.")
print("- Provide loyalty rewards for long-term subscribers.")
